[Defines]
  INF_VERSION                    = 0x0001001c
  BASE_NAME                      = SdCardBlockIoDxe
  FILE_GUID                      = 9CD8E4EB-4DFC-486E-9F14-3279F67B5127
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 0.1
  ENTRY_POINT                    = SdCardBlockIoDxeEntryPoint

[Sources]
  SdCardBlockIoDxe.c

[Packages]
  MdePkg/MdePkg.dec
  MT8167Pkg/MT8167Pkg.dec

[LibraryClasses]
  BaseLib
  BaseMemoryLib
  CacheMaintenanceLib
  DebugLib
  IoLib
  PcdLib
  TimerLib
  UefiBootServicesTableLib
  UefiDriverEntryPoint

[Protocols]
  gEfiBlockIoProtocolGuid
  gEfiDevicePathProtocolGuid

[FixedPcd]
  gMt8167TokenSpaceGuid.PcdMt8167SdCardBase
  gMt8167TokenSpaceGuid.PcdMt8167SdCardBlockSize

[Depex]
  gEfiCpuArchProtocolGuid
